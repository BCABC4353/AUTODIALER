{
  "name": "bcabc-autodialer",
  "version": "1.0.2",
  "description": "BCABC patient claim follow-up autodialer. Private-repo updates read the GitHub token from the AUTODIALER_GH_TOKEN environment variable at runtime; AWS credentials come from the machine's default profile chain (AWS_PROFILE).",
  "productName": "BCABC Autodialer",
  "author": "BC-ABC",
  "private": true,
  "main": "dist/main/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently -k \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 file:dist/main/main/index.js && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@aws-sdk/client-connect": "^3.900.0",
    "@aws-sdk/client-connectcampaignsv2": "^3.900.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1"
  }
}
